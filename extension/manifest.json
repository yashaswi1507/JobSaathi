{
  "manifest_version": 3,
  "name": "JobSaathi AI",
  "version": "2.0",
  "description": "Detect job fraud instantly on LinkedIn, Naukri, Indeed \u2014 Aapka Career Partner",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JobSaathi AI \u2014 Click to analyze",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.naukri.com/*",
        "https://www.indeed.com/*",
        "https://www.shine.com/*",
        "https://www.foundit.in/*",
        "https://internshala.com/*",
        "https://unstop.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}