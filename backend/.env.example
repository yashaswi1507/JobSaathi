# JobSaathi AI — Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key (free at console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# JWT Secret Key (any random string)
SECRET_KEY=your_super_secret_key_change_this

# Database (SQLite default — change for production)
DATABASE_URL=sqlite:///jobsaathi.db

# LaTeX Path (Windows MiKTeX)
# LATEX_PATH=C:\Users\HP\AppData\Local\Programs\MiKTeX\miktex\bin\x64

# Email OTP (Gmail SMTP)
# SMTP_EMAIL=your@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Production PostgreSQL (optional)
# DATABASE_URL=postgresql://user:password@host:5432/jobsaathi
